* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #1f2937;
    text-align: center;
    padding: 50px 20px;
}

h1 {
    color: #2563eb;
    margin-bottom: 15px;
}

p {
    margin-bottom: 30px;
    font-size: 18px;
}

button {
    padding: 12px 20px;
    margin: 8px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #1d4ed8;
}
